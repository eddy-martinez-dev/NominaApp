<Window x:Class="NominaApp.WPF.Views.NominaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NominaApp — Generar Nómina" Height="550" Width="600">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Generar Nómina" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Empleado:" VerticalAlignment="Center" Width="80"/>
            <ComboBox Width="250" ItemsSource="{Binding Empleados}"
                      SelectedItem="{Binding EmpleadoSeleccionado}"
                      DisplayMemberPath="Nombre"
                      Loaded="ComboBox_Loaded"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Período:" VerticalAlignment="Center" Width="80"/>
            <DatePicker Width="150" SelectedDate="{Binding Periodo}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Generar Nómina" Command="{Binding GenerarNominaCommand}" Padding="10,4"/>
            <TextBlock Text="{Binding MensajeError}" Foreground="Red" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Resultado -->
        <StackPanel Grid.Row="4" Visibility="{Binding NominaGenerada, Converter={StaticResource ObjectToVisibilityConverter}}">
            <TextBlock Text="{Binding NominaGenerada.NombreEmpleado}" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{Binding NominaGenerada.SalarioBruto, StringFormat='Salario Bruto: {0:C}'}"/>
            <TextBlock Text="{Binding NominaGenerada.TotalDeducciones, StringFormat='Total Deducciones: {0:C}'}"/>
            <TextBlock Text="{Binding NominaGenerada.TotalIngresosAdicionales, StringFormat='Ingresos Adicionales: {0:C}'}"/>
            <TextBlock Text="{Binding NominaGenerada.SalarioNeto, StringFormat='Salario Neto: {0:C}'}" FontWeight="Bold" FontSize="14" Margin="0,8,0,8"/>

            <TextBlock Text="Detalle:" FontWeight="Bold" Margin="0,8,0,4"/>
            <DataGrid ItemsSource="{Binding NominaGenerada.Detalles}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Concepto" Binding="{Binding Concepto}" Width="180"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="100"/>
                    <DataGridTextColumn Header="Monto" Binding="{Binding Monto, StringFormat=C}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="Exportar Comprobante (PDF)" 
                    Command="{Binding ExportarComprobanteCommand}" 
                    Margin="0,8,0,0" Padding="10,4"/>
        </StackPanel>
        
    </Grid>
</Window>